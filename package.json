{
  "name": "neonix-api",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "tsc -p tsconfig.json && concurrently -k -n tsc,node \"tsc -p tsconfig.json --watch --preserveWatchOutput\" \"node --env-file-if-exists=.env --watch dist/main.js\"",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@apple/app-store-server-library": "^1.2.0",
    "@aws-sdk/client-s3": "^3.787.0",
    "@aws-sdk/s3-request-presigner": "^3.787.0",
    "@nestjs/common": "^12.1.1",
    "@nestjs/core": "^12.1.1",
    "@nestjs/platform-express": "^12.1.1",
    "@nestjs/swagger": "^12.0.2",
    "better-auth": "^1.3.31",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "drizzle-orm": "^0.45.3",
    "express": "^5.1.0",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.1.1",
    "@swc/core": "^1.16.12",
    "@types/express": "^5.0.3",
    "@types/node": "^22.13.10",
    "@types/pg": "^8.15.6",
    "@types/supertest": "^6.0.3",
    "concurrently": "^10.0.5",
    "drizzle-kit": "^0.31.11",
    "supertest": "^7.1.4",
    "typescript": "^5.8.2",
    "unplugin-swc": "^2.0.0",
    "vitest": "^4.1.10"
  }
}
