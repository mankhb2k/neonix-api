PORT=8080
DATABASE_URL=postgres://api:api@localhost:5433/api

# Better Auth. BETTER_AUTH_URL is the public base URL of this API.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:8080

# Sign in with Apple (optional for now; enabled when both are set). APP_BUNDLE_ID is also the IAP bundle id.
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APP_BUNDLE_ID=com.neonix.editor
# Numeric App Store app id; required by Apple to verify production transactions.
APPLE_APP_ID=

# Google sign-in (required; email/password is disabled).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudflare R2. One bucket per purpose; the two public ones each have their own domain.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_TEMPLATES_BUCKET=neonix-templates
R2_TEMPLATE_PREVIEWS_BUCKET=neonix-template-previews
R2_TEMPLATE_PREVIEWS_URL=
R2_AVATARS_BUCKET=neonix-user-avatar
R2_AVATARS_URL=
# Neonix's own assets (stickers/...). The URL is optional: without it the API returns presigned URLs.
R2_SYSTEM_ASSETS_BUCKET=neonix-system-assets
R2_SYSTEM_ASSETS_URL=

# Website (neonix.video): origins allowed to call this API with cookies, comma separated. The first is where payOS returns.
WEB_ORIGINS=http://localhost:3000

# Web top-ups through payOS (VietQR). Without these the API still boots; /v1/billing/payos/* answers 503.
# Webhook URL to register in payOS: {BETTER_AUTH_URL}/webhooks/payos
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
# 1 credit costs this many VND on the web (1.000 VND = 10 credits).
VND_PER_CREDIT=100

# Defaults for new templates (admin can change each one).
DEFAULT_EXPORT_CREDITS=6
DEFAULT_CREATOR_EARNING_VND=300
# Creator is paid once unpaid purchases reach this many; below it they accumulate.
PAYOUT_MIN_PURCHASES=100

# Dev only (never in production): act as any user with the X-Dev-User header, no sign-in.
# Optional X-Dev-Role: user | creator | admin. Adds POST /v1/dev/credits to give test credits.
# DEV_AUTH_BYPASS=true
